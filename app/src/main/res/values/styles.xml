<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#2F6F62</color>
    <color name="brand_dark">#24574D</color>
    <color name="surface">#FFFFFF</color>
    <color name="page_bg">#F4F5F3</color>
    <color name="text_primary">#1F2421</color>
    <color name="text_secondary">#6B736F</color>
    <color name="divider">#E3E6E3</color>
    <color name="field_bg">#EDEFEC</color>
    <color name="badge">#D9483B</color>
    <color name="reader_panel">#FF222624</color>
    <color name="reader_panel_text">#E8ECE9</color>
    <color name="reader_panel_dim">#8C9792</color>

    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/surface</item>
        <item name="android:colorPrimaryDark">@color/surface</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="ReaderTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#6FBFAE</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#202422</item>
    </style>

    <style name="SettingsTheme" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>

    <style name="BarButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/text_primary</item>
    </style>

    <style name="ReaderMenuButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/reader_panel_text</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="ReaderChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/reader_panel_text</item>
        <item name="android:background">@drawable/chip_bg</item>
    </style>

    <style name="ReaderLabel">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/reader_panel_dim</item>
    </style>
</resources>
