<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.rc.novelreader.reader.PageView
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/reader_panel"
        android:clickable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:tint="@color/reader_panel_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bookTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/reader_panel_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/sourceUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/reader_panel_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnShelf"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/chip_bg"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/add_to_shelf"
            android:textColor="@color/reader_panel_text"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btnReload"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reload_chapter"
            android:src="@drawable/ic_refresh"
            android:tint="@color/reader_panel_text" />

        <ImageButton
            android:id="@+id/btnWeb"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/web_page"
            android:src="@drawable/ic_globe"
            android:tint="@color/reader_panel_text" />
    </LinearLayout>

    <!-- bottom bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/reader_panel"
        android:clickable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/btnPrev"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/prev_chapter"
                android:textColor="@color/reader_panel_text"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnNext"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/next_chapter"
                android:textColor="@color/reader_panel_text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnToc"
                style="@style/ReaderMenuButton"
                android:text="@string/contents" />

            <TextView
                android:id="@+id/btnNight"
                style="@style/ReaderMenuButton"
                android:text="@string/night" />

            <TextView
                android:id="@+id/btnDisplay"
                style="@style/ReaderMenuButton"
                android:text="@string/display" />

            <TextView
                android:id="@+id/btnCache"
                style="@style/ReaderMenuButton"
                android:text="@string/cache" />
        </LinearLayout>
    </LinearLayout>

    <!-- display settings -->
    <LinearLayout
        android:id="@+id/displayPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/reader_panel"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView style="@style/ReaderLabel" android:text="@string/brightness" />

            <SeekBar
                android:id="@+id/brightSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:id="@+id/brightSystem"
                style="@style/ReaderChip"
                android:layout_width="wrap_content"
                android:layout_weight="0"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/system" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView style="@style/ReaderLabel" android:text="@string/font_size" />
            <TextView android:id="@+id/fontMinus" style="@style/ReaderChip" android:text="A−" />
            <TextView
                android:id="@+id/fontValue"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/reader_panel_text"
                android:textSize="14sp" />
            <TextView android:id="@+id/fontPlus" style="@style/ReaderChip" android:text="A+" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView style="@style/ReaderLabel" android:text="@string/line_spacing" />
            <TextView android:id="@+id/lineMinus" style="@style/ReaderChip" android:text="−" />
            <TextView
                android:id="@+id/lineValue"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/reader_panel_text"
                android:textSize="14sp" />
            <TextView android:id="@+id/linePlus" style="@style/ReaderChip" android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView style="@style/ReaderLabel" android:text="@string/margins" />
            <TextView android:id="@+id/marginMinus" style="@style/ReaderChip" android:text="−" />
            <TextView
                android:id="@+id/marginValue"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/reader_panel_text"
                android:textSize="14sp" />
            <TextView android:id="@+id/marginPlus" style="@style/ReaderChip" android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/themeRow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView style="@style/ReaderLabel" android:text="@string/page_turn" />
            <TextView android:id="@+id/modeCover" style="@style/ReaderChip" android:text="@string/mode_cover" />
            <TextView android:id="@+id/modeSlide" style="@style/ReaderChip" android:text="@string/mode_slide" />
            <TextView android:id="@+id/modeNone" style="@style/ReaderChip" android:text="@string/mode_none" />
            <TextView android:id="@+id/modeScroll" style="@style/ReaderChip" android:text="@string/mode_scroll" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/optKeepOn" style="@style/ReaderChip" android:text="@string/keep_screen_on" />
            <TextView android:id="@+id/optVolume" style="@style/ReaderChip" android:text="@string/volume_keys" />
        </LinearLayout>
    </LinearLayout>

    <!-- contents -->
    <LinearLayout
        android:id="@+id/tocPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tocBody"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:background="#FF222624"
            android:clickable="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tocTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="@color/reader_panel_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tocInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/reader_panel_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tocRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/chip_bg"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/refresh"
                    android:textColor="@color/reader_panel_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tocReverse"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/chip_bg"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/reverse_order"
                    android:textColor="@color/reader_panel_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <ListView
                android:id="@+id/tocList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#18FFFFFF"
                android:dividerHeight="1px"
                android:fastScrollEnabled="true" />
        </LinearLayout>

        <View
            android:id="@+id/tocScrim"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#99000000" />
    </LinearLayout>

    <TextView
        android:id="@+id/seekTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/tip_bg"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
