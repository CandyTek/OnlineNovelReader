<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btnShelf"
                style="@style/BarButton"
                android:contentDescription="@string/bookshelf"
                android:src="@drawable/ic_book" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/field_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="2dp">

                <ImageButton
                    android:id="@+id/siteIcon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/page_info"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_search"
                    android:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/url"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/url_hint"
                    android:imeOptions="actionGo|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textUri|textNoSuggestions"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/blocked"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_primary"
                    android:gravity="center"
                    android:minWidth="20dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnStar"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/add_bookmark"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_star_border"
                    android:tint="@color/text_secondary" />

                <ImageButton
                    android:id="@+id/btnClear"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    android:tint="@color/text_secondary"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnReload"
                style="@style/BarButton"
                android:contentDescription="@string/refresh"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/findBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/findText"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/field_bg"
                android:hint="@string/find_in_page"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/findCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/findPrev"
                style="@style/BarButton"
                android:layout_width="40dp"
                android:rotation="90"
                android:src="@drawable/ic_back" />

            <ImageButton
                android:id="@+id/findNext"
                style="@style/BarButton"
                android:layout_width="40dp"
                android:rotation="270"
                android:src="@drawable/ic_back" />

            <ImageButton
                android:id="@+id/findClose"
                style="@style/BarButton"
                android:layout_width="40dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_line" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/webHolder"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ScrollView
                android:id="@+id/home"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/page_bg"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/homeBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="36dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="24dp" />
            </ScrollView>

            <TextView
                android:id="@+id/fab"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/fab_bg"
                android:drawableStart="@drawable/ic_book"
                android:drawablePadding="8dp"
                android:drawableTint="#FFFFFF"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="20dp"
                android:text="@string/reading_mode"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/exitFull"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="22dp"
                android:alpha="0.75"
                android:background="@drawable/fab_bg"
                android:elevation="6dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_fullscreen"
                android:tint="#FFFFFF"
                android:visibility="gone" />

            <ListView
                android:id="@+id/suggest"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/surface"
                android:divider="@null"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:id="@+id/bottomLine"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="@color/divider" />

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/BarButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <ImageButton
                android:id="@+id/btnForward"
                style="@style/BarButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/forward"
                android:src="@drawable/ic_forward" />

            <ImageButton
                android:id="@+id/btnHome"
                style="@style/BarButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/start_page"
                android:src="@drawable/ic_home" />

            <FrameLayout
                android:id="@+id/btnTabs"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tabs">

                <TextView
                    android:id="@+id/tabCount"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="@drawable/tab_count_bg"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnMenu"
                style="@style/BarButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/menu"
                android:src="@drawable/ic_more" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/customBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone" />
</FrameLayout>
